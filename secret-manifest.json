{
    "schemaVersion":  1,
    "project":  "agent-harness",
    "variables":  [
                      {
                          "name":  "BWS_ACCESS_TOKEN",
                          "purpose":  "Authenticate one computer\u0027s read-only Bitwarden Secrets Manager broker session.",
                          "source":  "Windows Credential Manager at machine bootstrap",
                          "provider":  "Bitwarden Secrets Manager",
                          "trustBoundary":  "local agent broker",
                          "owner":  "Douglas",
                          "rotation":  "on compromise, device retirement, ownership change, or provider policy",
                          "consumers":  [
                                            ".agents/tools/Invoke-WithBitwardenSecret.ps1"
                                        ],
                          "status":  "bootstrap-required"
                      },
                      {
                          "name":  "PROJECT_DATA_ROOT",
                          "purpose":  "Locate this computer\u0027s external per-project data root.",
                          "source":  "receiving-computer environment configuration",
                          "provider":  "Windows user environment",
                          "trustBoundary":  "local configuration",
                          "owner":  "Douglas",
                          "rotation":  "when the local data root moves",
                          "consumers":  [
                                            ".agents/tools/Sync-SqliteProjectData.ps1"
                                        ],
                          "status":  "non-secret-config"
                      },
                      {
                          "name":  "PROJECT_DATA_SYNC_ROOT",
                          "purpose":  "Locate the Google Drive root used by reviewed external-data adapters.",
                          "source":  "receiving-computer environment configuration",
                          "provider":  "Windows user environment",
                          "trustBoundary":  "local configuration",
                          "owner":  "Douglas",
                          "rotation":  "when the Google Drive sync root moves",
                          "consumers":  [
                                            ".agents/tools/Sync-SqliteProjectData.ps1"
                                        ],
                          "status":  "non-secret-config"
                      }
                  ]
}

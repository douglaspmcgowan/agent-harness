{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|Read|Grep|Glob|mcp__obsidian__.*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/PROGRA~1/nodejs/node.exe {{HOME_POSIX}}/.agents/hooks/security-dispatch.js PreToolUse --product=claude",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|Agent|Task|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "C:/PROGRA~1/nodejs/node.exe {{HOME_POSIX}}/.agents/hooks/security-dispatch.js PostToolUse --product=claude",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "TaskCreate|TaskUpdate|TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "C:/PROGRA~1/nodejs/node.exe {{HOME_POSIX}}/.agents/hooks/task-state-dispatch.js PostToolUse --product=claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/PROGRA~1/nodejs/node.exe {{HOME_POSIX}}/.agents/hooks/task-state-dispatch.js UserPromptSubmit --product=claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/PROGRA~1/nodejs/node.exe {{HOME_POSIX}}/.agents/hooks/task-state-dispatch.js SessionStart --product=claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/PROGRA~1/nodejs/node.exe {{HOME_POSIX}}/.agents/hooks/task-state-dispatch.js PreCompact --product=claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/PROGRA~1/nodejs/node.exe {{HOME_POSIX}}/.agents/hooks/continue-dispatch.js Stop --product=claude --legacy=test-green-gate.js",
            "timeout": 18900
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_complete|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "C:/PROGRA~1/nodejs/node.exe {{HOME_POSIX}}/.agents/hooks/task-state-dispatch.js Notification --product=claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
